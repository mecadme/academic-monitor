import { useEffect, useState } from "react";
import {
  type DashboardResult,
  getDashboard,
  syncDemo,
} from "./api/demo";

function App() {
  const [dashboard, setDashboard] =
    useState<DashboardResult | null>(null);

  const [teacherUserId, setTeacherUserId] =
    useState<string | null>(null);

  const [loading, setLoading] = useState(true);
  const [syncing, setSyncing] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function loadScenario(
    scenario: "INITIAL" | "IMPROVED",
  ) {
    try {
      setSyncing(true);
      setError(null);

      const sync = await syncDemo(scenario);

      setTeacherUserId(sync.teacherUserId);

      const data = await getDashboard(
        sync.teacherUserId,
      );

      setDashboard(data);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Ocurrió un error inesperado.",
      );
    } finally {
      setSyncing(false);
      setLoading(false);
    }
  }

  async function refreshDashboard() {
    if (!teacherUserId) {
      return;
    }

    const data = await getDashboard(teacherUserId);
    setDashboard(data);
  }

  useEffect(() => {
    loadScenario("INITIAL");
  }, []);

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-50 flex items-center justify-center">
        <p className="text-slate-600">
          Preparando Academic Monitor...
        </p>
      </main>
    );
  }

  if (error && !dashboard) {
    return (
      <main className="min-h-screen bg-slate-50 flex items-center justify-center">
        <div className="rounded-xl bg-white p-8 shadow-sm">
          <h1 className="text-xl font-semibold text-slate-900">
            No se pudo cargar Academic Monitor
          </h1>

          <p className="mt-2 text-slate-600">
            {error}
          </p>

          <button
            onClick={() => loadScenario("INITIAL")}
            className="mt-5 rounded-lg bg-slate-900 px-4 py-2 text-white"
          >
            Reintentar
          </button>
        </div>
      </main>
    );
  }

  if (!dashboard) {
    return null;
  }

  return (
    <main className="min-h-screen bg-slate-50">
      <header className="border-b bg-white">
        <div className="mx-auto max-w-7xl px-6 py-5">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h1 className="text-2xl font-bold text-slate-950">
                Academic Monitor
              </h1>

              <p className="mt-1 text-sm text-slate-500">
                Monitoreo académico inteligente
              </p>
            </div>

            <div className="flex gap-3">
              <button
                disabled={syncing}
                onClick={() =>
                  loadScenario("INITIAL")
                }
                className="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50"
              >
                Sincronizar
              </button>

              <button
                disabled={syncing}
                onClick={() =>
                  loadScenario("IMPROVED")
                }
                className="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800 disabled:opacity-50"
              >
                {syncing
                  ? "Procesando..."
                  : "Simular mejora"}
              </button>
            </div>
          </div>
        </div>
      </header>

      <section className="mx-auto max-w-7xl px-6 py-8">
        {error && (
          <div className="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            {error}
          </div>
        )}

        <div>
          <p className="text-sm font-medium text-slate-500">
            Curso monitoreado
          </p>

          <h2 className="mt-1 text-3xl font-bold text-slate-950">
            {dashboard.courseName}
          </h2>

          <p className="mt-1 text-slate-600">
            {dashboard.subject}
          </p>
        </div>

        <div className="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <SummaryCard
            label="Estudiantes"
            value={dashboard.summary.totalStudents}
          />

          <SummaryCard
            label="Alertas abiertas"
            value={dashboard.summary.openAlerts}
          />

          <SummaryCard
            label="Avisos"
            value={dashboard.summary.warnings}
          />

          <SummaryCard
            label="Críticos"
            value={dashboard.summary.critical}
          />
        </div>

        <section className="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <div className="border-b border-slate-200 px-6 py-5">
            <p className="text-sm text-slate-500">
              Actividad analizada
            </p>

            <h3 className="mt-1 text-lg font-semibold text-slate-900">
              {dashboard.activity.name}
            </h3>
          </div>

          <div className="overflow-x-auto">
            <table className="w-full text-left">
              <thead className="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th className="px-6 py-4">
                  Estudiante
                </th>

                <th className="px-6 py-4">
                  Nota
                </th>

                <th className="px-6 py-4">
                  Estado
                </th>
              </tr>
              </thead>

              <tbody className="divide-y divide-slate-100">
              {dashboard.students.map(
                (student) => (
                  <tr
                    key={student.id}
                    className="hover:bg-slate-50"
                  >
                    <td className="px-6 py-4 font-medium text-slate-900">
                      {student.name}
                    </td>

                    <td className="px-6 py-4 text-slate-700">
                      {student.score.toFixed(2)}
                    </td>

                    <td className="px-6 py-4">
                      <StatusBadge
                        status={student.status}
                      />
                    </td>
                  </tr>
                ),
              )}
              </tbody>
            </table>
          </div>

          <div className="flex flex-wrap gap-6 border-t border-slate-200 bg-slate-50 px-6 py-4 text-sm text-slate-600">
            <span>
              Alertas resueltas:{" "}
              <strong>
                {dashboard.summary.resolvedAlerts}
              </strong>
            </span>

            <button
              onClick={refreshDashboard}
              className="font-medium text-slate-900 hover:underline"
            >
              Actualizar vista
            </button>
          </div>
        </section>
      </section>
    </main>
  );
}

function SummaryCard({
                       label,
                       value,
                     }: {
  label: string;
  value: number;
}) {
  return (
    <article className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <p className="text-sm font-medium text-slate-500">
        {label}
      </p>

      <p className="mt-2 text-3xl font-bold text-slate-950">
        {value}
      </p>
    </article>
  );
}

function StatusBadge({
                       status,
                     }: {
  status: "OK" | "WARNING" | "CRITICAL";
}) {
  const styles = {
    OK: "bg-emerald-100 text-emerald-700",
    WARNING: "bg-amber-100 text-amber-800",
    CRITICAL: "bg-red-100 text-red-700",
  };

  const labels = {
    OK: "Bien",
    WARNING: "Aviso",
    CRITICAL: "Crítico",
  };

  return (
    <span
      className={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${styles[status]}`}
    >
      {labels[status]}
    </span>
  );
}

export default App;
