# Copy to .env for local development.
# Values here are fictitious and safe for a public repository.

POSTGRES_DB=academic_monitor
POSTGRES_USER=academic_monitor
POSTGRES_PASSWORD=change-me-local-only

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/academic_monitor
SPRING_DATASOURCE_USERNAME=academic_monitor
SPRING_DATASOURCE_PASSWORD=change-me-local-only

OLLAMA_BASE_URL=http://ollama:11434
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Required: supply your own Base64-encoded random secret (at least 32 bytes).
APP_AUTH_JWT_SECRET_BASE64=
APP_AUTH_ACCESS_TTL=15m
APP_AUTH_REFRESH_TTL=7d
# Local HTTP development only; production requires true and HTTPS.
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax

# Development only. Reuse the existing email to preserve user and academic ownership.
APP_BOOTSTRAP_USER_EMAIL=local.teacher@academicmonitor.local
APP_BOOTSTRAP_INSTITUTION_NAME=Academic Monitor Local
APP_BOOTSTRAP_TIMEZONE=America/Guayaquil
# No default password. Only initializes a missing password hash.
APP_BOOTSTRAP_PASSWORD=

IDUKAY_TEST_LOGIN_ENABLED=true
IDUKAY_TEST_NOTIFICATION_RECIPIENT_USER_ID=
